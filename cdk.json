{
  "app": "python3 app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/__init__.py",
      "**/__pycache__",
      "tests"
    ]
  },
  "context": {
    "dev01": {
      "project_name": "rca",
      "region": "eu-west-1",
      "bedrock": {
        "region": "eu-west-1",
        "model_prefix": "eu",
        "models": {
          "fast": {
            "model_id": "eu.anthropic.claude-haiku-4-5-20251001-v1:0",
            "description": "Fast responses, simple tasks",
            "use_cases": ["chat_responses", "simple_extraction"]
          },
          "standard": {
            "model_id": "eu.anthropic.claude-sonnet-4-6-20250514-v1:0",
            "description": "Balanced quality and speed",
            "use_cases": ["agent_tasks", "diagnosis"]
          },
          "advanced": {
            "model_id": "eu.anthropic.claude-opus-4-6-v1:0",
            "description": "Complex reasoning, strategic decisions",
            "use_cases": ["master_agent", "multi_step_reasoning"]
          },
          "voice": {
            "model_id": "amazon.nova-sonic-v1:0",
            "description": "Speech-to-speech real-time voice",
            "use_cases": ["emergency_call", "voice_authentication"]
          }
        },
        "default_model_tier": "standard"
      },
      "ecs": {
        "cpu": 512,
        "memory_mib": 1024,
        "desired_count": 1
      },
      "features": {
        "enable_voice_call": true,
        "enable_whatsapp": false,
        "enable_jira": false
      },
      "nlb_cert_arn": "arn:aws:acm:eu-west-1:000000000000:certificate/00000000-6944-48a8-b3df-767c889ab2d2",
      "twilio": {
        "secret_name": "rca/twilio/credentials",
        "secret_arn": "arn:aws:secretsmanager:eu-west-1:000000000000:secret:rca-secret-twilio-000000000000-eu-west-1-dev01-XXXXXX"
      },
      "agentcore": {
        "runtime_arn": "arn:aws:bedrock-agentcore:eu-west-1:000000000000:runtime/rca_voice_agent_dev01-XXXXXXXXXX"
      }
    },
    "prod": {
      "project_name": "rca",
      "region": "eu-west-1",
      "bedrock": {
        "region": "eu-west-1",
        "model_prefix": "eu",
        "models": {
          "fast": { "model_id": "eu.anthropic.claude-haiku-4-5-20251001-v1:0" },
          "standard": { "model_id": "eu.anthropic.claude-sonnet-4-6-20250514-v1:0" },
          "advanced": { "model_id": "eu.anthropic.claude-opus-4-6-v1:0" },
          "voice": { "model_id": "amazon.nova-sonic-v1:0" }
        },
        "default_model_tier": "standard"
      },
      "ecs": {
        "cpu": 1024,
        "memory_mib": 2048,
        "desired_count": 2
      },
      "features": {
        "enable_voice_call": true,
        "enable_whatsapp": true,
        "enable_jira": true
      },
      "twilio": {
        "secret_name": "rca/twilio/credentials"
      }
    }
  }
}
