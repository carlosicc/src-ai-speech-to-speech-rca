{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cdk diff:*)",
      "Bash(cdk synth:*)",
      "Bash(pytest:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(cdk destroy:*)",
      "Bash(aws * delete-*:*)",
      "Bash(aws * remove-*:*)"
    ]
  },
  "model": "claude-sonnet-4-6"
}
